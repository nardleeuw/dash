# =============================================================================
# Leadwerk — environment variables
# Copy to .env (local) or configure in Vercel. NEVER commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; all others are
# server-only.
# =============================================================================

# --- App ----------------------------------------------------------------------
APP_URL=http://localhost:3000
# development | staging | production. In production, mock providers are disabled.
APP_ENV=development
# "auto" = use a mock adapter when a provider's key is missing (non-production only).
# Or a comma-separated list to force mocks: kvk,google_places,osm,hunter,openai,email
MOCK_PROVIDERS=auto

# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=
# Models are configurable per task.
OPENAI_MODEL_RESEARCH=gpt-5.4-mini
OPENAI_MODEL_SCORING=gpt-5.4-mini
OPENAI_MODEL_EMAIL=gpt-5.5
OPENAI_MODEL_REPLIES=gpt-5.4-mini

# --- Google Maps Platform (Places API New) -----------------------------------
GOOGLE_MAPS_API_KEY=
# Optional: PageSpeed Insights for website performance/mobile scores.
GOOGLE_PAGESPEED_API_KEY=

# --- KVK Handelsregister API ---------------------------------------------------
# The public KVK *test* key may be used against the test environment:
#   KVK_API_KEY=l7xx1f2691f2520d487b902f4e0b57a0b197
KVK_API_KEY=
# Test: https://api.kvk.nl/test/api   Production: https://api.kvk.nl/api
KVK_BASE=https://api.kvk.nl/test/api

# --- Hunter.io ------------------------------------------------------------------
HUNTER_API_KEY=

# --- Stripe ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email sending --------------------------------------------------------------
# Reserved for a dedicated outbound email provider adapter (optional).
EMAIL_PROVIDER_API_KEY=
# OAuth apps for connecting Google Workspace / Microsoft 365 mailboxes (optional).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# --- Security -------------------------------------------------------------------
# 32 random bytes, base64. Encrypts mailbox credentials at rest.
#   openssl rand -base64 32
ENCRYPTION_KEY=
# HMAC secret for unsubscribe links.  openssl rand -base64 32
UNSUBSCRIBE_SECRET=

# --- Inngest (background jobs) --------------------------------------------------
# Not needed locally with `npx inngest-cli dev`; required in production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
